# ─── Gemini API ───────────────────────────────────────────────────────────────
# Required for script generation (Stage 1)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Wan2GP ───────────────────────────────────────────────────────────────────
# Path to your Wan2GP installation folder on the desktop (GPU machine)
# Used for: image generation (Krea 2 Raw + Ideogram 4) and TTS (Qwen3-TTS)
# The backend imports shared/api.py directly from this folder
WAN2GP_PATH=C:\WanGP
