# ─── Gemini API ───────────────────────────────────────────────────────────────
# Required for script generation (Stage 1)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Wan2GP ───────────────────────────────────────────────────────────────────
# Path to your Wan2GP installation folder
WAN2GP_PATH=C:\WanGP

# Full path to the Python venv used by Wan2GP
# (check your Wan2GP folder — it may be named venv, .venv, env, wan2gp-env, etc.)
WAN2GP_VENV=C:\WanGP\venv
